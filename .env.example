# Copy this file to ".env" and edit the values before running
# "docker compose up -d".

# Where downloaded audio lands on the host, for example /mnt/tank/Music.
# This is the one setting most people need to change.
MUSIC_DIR_HOST=./music

# Where the app's settings persist across container restarts and updates.
# Usually fine left as the default.
CONFIG_DIR_HOST=./config
