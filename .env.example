# Copy this file to ".env" and edit the values before running
# "docker compose up -d".

# Where downloaded MP3s should actually land on the host / TrueNAS - e.g.
# /mnt/tank/Music. This is the main setting most people need to change.
MUSIC_DIR_HOST=./music

# Where the app's settings (saved through its Settings panel in the browser -
# Spotify credentials, ListenBrainz token) persist across container
# restarts/updates. Usually fine left as the default.
CONFIG_DIR_HOST=./config
